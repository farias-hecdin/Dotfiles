#!/usr/bin/env bash
#
# plugvault — instalador minimalista de plugins de Neovim, sin git.
# Descarga tarballs de GitHub, purga lo innecesario y hace swap atómico.
#
# Uso:   plugvault [sync|add|list|prune|help] [opciones]
#

set -Eeuo pipefail

readonly VERSION="2.0"

# ── Configuración (sobreescribible por entorno) ───────────────────────────────
: "${PLUGVAULT_DIR:=${HOME}/.config/nvim/plugvault}"
: "${PLUGVAULT_MANIFEST:=${PLUGVAULT_DIR}/plugins.txt}"
: "${PLUGVAULT_JOBS:=2}"

LOG_DIR="${PLUGVAULT_DIR}/.logs"
KEEP_TESTS=0
KEEP_MEDIA=0

# Directorios/archivos de nivel superior que se borran tras extraer.
# OJO: no incluir 'doc' (rompe :help) ni 'build'/'Makefile'/'src'
# (rompe plugins que compilan, p.ej. telescope-fzf-native).
PURGE_PATHS=(
  .github .git .gitignore .gitattributes .gitmodules
  .editorconfig .pre-commit-config.yaml .luacheckrc .busted
  media screenshots assets/img doc/images .images
)
PURGE_TESTS=(tests test spec)
PURGE_GLOBS=(-name '*.png' -o -name '*.jpg' -o -name '*.jpeg'
             -o -name '*.gif' -o -name '*.webp' -o -name '*.svg'
             -o -name '*.mp4' -o -name '*.ico')

# ── Colores solo si hay terminal ──────────────────────────────────────────────
if [[ -t 1 ]]; then
  C_OK=$'\033[32m'; C_ERR=$'\033[31m'; C_WARN=$'\033[33m'
  C_DIM=$'\033[2m';  C_BOLD=$'\033[1m'; C_OFF=$'\033[0m'
else
  C_OK=; C_ERR=; C_WARN=; C_DIM=; C_BOLD=; C_OFF=
fi

die()  { printf '%s❌ %s%s\n' "$C_ERR" "$*" "$C_OFF" >&2; exit 1; }
warn() { printf '%s⚠️  %s%s\n' "$C_WARN" "$*" "$C_OFF" >&2; }
info() { printf '%s\n' "$*"; }

# ── Requisitos ────────────────────────────────────────────────────────────────
check_deps() {
  ((BASH_VERSINFO[0] > 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] >= 3))) \
    || die "Se requiere bash >= 4.3 (tienes ${BASH_VERSION})."
  command -v curl >/dev/null || die "Falta 'curl'."
  command -v tar  >/dev/null || die "Falta 'tar'."
  tar --help 2>&1 | grep -q -- --strip-components \
    || warn "Tu 'tar' quizá no soporte --strip-components (¿busybox?)."
}

# ── Parseo del manifest ───────────────────────────────────────────────────────
# Acepta:  user/repo
#          user/repo@v1.2.0        (tag o rama)
#          https://github.com/user/repo(.git)
#          # comentarios y espacios
declare -a M_USER=() M_REPO=() M_REF=()

parse_manifest() {
  [[ -f $PLUGVAULT_MANIFEST ]] || die \
    "No existe el manifest: ${PLUGVAULT_MANIFEST}
   Créalo con:  plugvault add usuario/repo"

  local -A seen=()
  local line spec user repo ref n=0
  while IFS= read -r line || [[ -n $line ]]; do
    ((++n))
    line=${line%%#*}                                  # quita comentario
    line=${line#"${line%%[![:space:]]*}"}             # ltrim
    line=${line%"${line##*[![:space:]]}"}             # rtrim
    [[ -z $line ]] && continue

    spec=$line
    spec=${spec#https://github.com/}
    spec=${spec#http://github.com/}
    spec=${spec#git@github.com:}
    spec=${spec%/}
    spec=${spec%.git}

    ref=HEAD
    if [[ $spec == *@* ]]; then ref=${spec##*@}; spec=${spec%@*}; fi

    if [[ ! $spec =~ ^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ ]]; then
      warn "Línea ${n} inválida, se ignora: ${line}"
      continue
    fi

    user=${spec%%/*}; repo=${spec##*/}

    if [[ -n ${seen[$repo]:-} ]]; then
      die "Colisión de nombres: '${repo}' aparece en ${seen[$repo]} y en ${spec}.
   Los dos ocuparían la misma carpeta. Renombra uno o quítalo."
    fi
    seen[$repo]=$spec

    M_USER+=("$user"); M_REPO+=("$repo"); M_REF+=("$ref")
  done < "$PLUGVAULT_MANIFEST"

  ((${#M_REPO[@]})) || die "El manifest no contiene entradas válidas."
}

# ── Instalación de un plugin (se ejecuta en subshell de fondo) ────────────────
install_one() {
  local user=$1 repo=$2 ref=$3 faildir=$4
  local name="${user}/${repo}"
  local target="${PLUGVAULT_DIR}/${repo}"
  local log="${LOG_DIR}/${user}__${repo}.log"
  local url="https://codeload.github.com/${user}/${repo}/tar.gz/${ref}"
  local tmp

  tmp=$(mktemp -d "${PLUGVAULT_DIR}/.tmp.XXXXXXXX") || {
    printf '%s❌ %-38s no se pudo crear temp%s\n' "$C_ERR" "$name" "$C_OFF"
    : > "${faildir}/${user}__${repo}"; return 0
  }
  trap 'rm -rf -- "$tmp" "${tmp}.old"' EXIT

  if ! {
        set -o pipefail
        curl -sSfL --retry 2 --retry-delay 2 --connect-timeout 20 --max-time 300 \
             "$url" | tar -xzf - -C "$tmp" --strip-components=1
      } >"$log" 2>&1
  then
    printf '%s❌ %-38s fallo de descarga  %s(%s)%s\n' \
           "$C_ERR" "$name" "$C_DIM" "${log/#$HOME/\~}" "$C_OFF"
    : > "${faildir}/${user}__${repo}"
    return 0
  fi

  # ── Purga ───────────────────────────────────────────────────────────────
  {
    local -a doomed=("${PURGE_PATHS[@]}")
    ((KEEP_TESTS)) || doomed+=("${PURGE_TESTS[@]}")
    local p
    for p in "${doomed[@]}"; do rm -rf -- "${tmp:?}/${p}"; done
    ((KEEP_MEDIA)) || find "$tmp" -type f \( "${PURGE_GLOBS[@]}" \) -delete
    find "$tmp" -type d -empty -delete 2>/dev/null || true
  } >>"$log" 2>&1

  # ── Swap atómico: nunca queda un instante sin plugin válido ─────────────
  if ! {
        [[ -d $target ]] && mv -- "$target" "${tmp}.old"
        mv -- "$tmp" "$target"
        rm -rf -- "${tmp}.old"
      } >>"$log" 2>&1
  then
    [[ -d "${tmp}.old" && ! -d $target ]] && mv -- "${tmp}.old" "$target"
    printf '%s❌ %-38s fallo al instalar  %s(%s)%s\n' \
           "$C_ERR" "$name" "$C_DIM" "${log/#$HOME/\~}" "$C_OFF"
    : > "${faildir}/${user}__${repo}"
    return 0
  fi

  trap - EXIT
  rm -f -- "$log"
  local size; size=$(du -sh -- "$target" 2>/dev/null | cut -f1)
  printf '%s✅ %-38s%s %s%s%s\n' "$C_OK" "$name" "$C_OFF" "$C_DIM" "${size:-?}" "$C_OFF"
  return 0
}

# ── Comando: sync ─────────────────────────────────────────────────────────────
cmd_sync() {
  check_deps
  mkdir -p -- "$PLUGVAULT_DIR" "$LOG_DIR" || die "No se pudo crear ${PLUGVAULT_DIR}"
  parse_manifest

  local total=${#M_REPO[@]} faildir
  faildir=$(mktemp -d) || die "mktemp falló"
  # shellcheck disable=SC2064
  trap "rm -rf -- '$faildir'; kill 0 2>/dev/null" INT TERM

  printf '%s⚡ PlugVault %s%s — %d plugins, %d descargas en paralelo\n\n' \
         "$C_BOLD" "$VERSION" "$C_OFF" "$total" "$PLUGVAULT_JOBS"

  local i running=0
  for ((i = 0; i < total; i++)); do
    while ((running >= PLUGVAULT_JOBS)); do
      wait -n 2>/dev/null || true
      ((running--))
    done
    install_one "${M_USER[i]}" "${M_REPO[i]}" "${M_REF[i]}" "$faildir" &
    ((running++))
  done
  wait

  local failed; failed=$(find "$faildir" -type f | wc -l | tr -d ' ')
  rm -rf -- "$faildir"
  trap - INT TERM

  gen_helptags

  local size; size=$(du -sh -- "$PLUGVAULT_DIR" 2>/dev/null | cut -f1)
  printf '\n%s✨ %d/%d instalados%s' "$C_BOLD" "$((total - failed))" "$total" "$C_OFF"
  ((failed)) && printf ' %s(%d con errores → %s)%s' \
                        "$C_ERR" "$failed" "${LOG_DIR/#$HOME/\~}" "$C_OFF"
  printf '  ·  total en disco: %s\n' "${size:-?}"
  return $((failed > 0))
}

gen_helptags() {
  command -v nvim >/dev/null || return 0
  local d found=0
  for d in "$PLUGVAULT_DIR"/*/doc; do
    [[ -d $d ]] || continue
    compgen -G "$d/*.txt" >/dev/null || continue
    nvim --headless -c "helptags $d" -c q >/dev/null 2>&1 || true
    found=1
  done
  ((found)) && printf '%s   📚 helptags regenerados%s\n' "$C_DIM" "$C_OFF"
  return 0
}

# ── Comando: add ──────────────────────────────────────────────────────────────
cmd_add() {
  (($#)) || die "Uso: plugvault add usuario/repo [usuario/repo@tag ...]"
  mkdir -p -- "$(dirname -- "$PLUGVAULT_MANIFEST")"
  [[ -f $PLUGVAULT_MANIFEST ]] || {
    printf '# PlugVault — un plugin por línea: usuario/repo[@tag]\n' \
      > "$PLUGVAULT_MANIFEST"
  }
  local a spec
  for a in "$@"; do
    spec=${a#https://github.com/}; spec=${spec#git@github.com:}
    spec=${spec%/}; spec=${spec%.git}
    [[ $spec =~ ^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+(@[A-Za-z0-9._/-]+)?$ ]] \
      || { warn "Formato inválido: ${a}"; continue; }
    if grep -qxF "$spec" "$PLUGVAULT_MANIFEST" 2>/dev/null; then
      info "   ${C_DIM}ya estaba: ${spec}${C_OFF}"
    else
      printf '%s\n' "$spec" >> "$PLUGVAULT_MANIFEST"
      info "   ${C_OK}+ ${spec}${C_OFF}"
    fi
  done
  info "\nEjecuta ${C_BOLD}plugvault sync${C_OFF} para instalarlos."
}

# ── Comando: list ─────────────────────────────────────────────────────────────
cmd_list() {
  parse_manifest
  local i target state size
  printf '%s%-38s %-10s %s%s\n' "$C_BOLD" "PLUGIN" "REF" "ESTADO" "$C_OFF"
  for ((i = 0; i < ${#M_REPO[@]}; i++)); do
    target="${PLUGVAULT_DIR}/${M_REPO[i]}"
    if [[ -d $target ]]; then
      size=$(du -sh -- "$target" 2>/dev/null | cut -f1)
      state="${C_OK}instalado${C_OFF} ${C_DIM}${size}${C_OFF}"
    else
      state="${C_WARN}pendiente${C_OFF}"
    fi
    printf '%-38s %-10s %b\n' "${M_USER[i]}/${M_REPO[i]}" "${M_REF[i]}" "$state"
  done
}

# ── Comando: prune ────────────────────────────────────────────────────────────
cmd_prune() {
  parse_manifest
  local -A wanted=()
  local i d base
  for ((i = 0; i < ${#M_REPO[@]}; i++)); do wanted[${M_REPO[i]}]=1; done

  local -a orphans=()
  for d in "$PLUGVAULT_DIR"/*/; do
    [[ -d $d ]] || continue
    base=$(basename -- "$d")
    [[ $base == .* ]] && continue
    [[ -n ${wanted[$base]:-} ]] || orphans+=("$base")
  done

  ((${#orphans[@]})) || { info "Nada que eliminar."; return 0; }
  info "Estas carpetas no están en el manifest:"
  printf '   %s\n' "${orphans[@]}"
  read -r -p "¿Eliminarlas? [y/N] " ans
  [[ ${ans,,} == y ]] || { info "Cancelado."; return 0; }
  for base in "${orphans[@]}"; do
    rm -rf -- "${PLUGVAULT_DIR:?}/${base}" && info "   ${C_OK}- ${base}${C_OFF}"
  done
}

# ── Ayuda ─────────────────────────────────────────────────────────────────────
cmd_help() {
cat <<EOF
${C_BOLD}PlugVault ${VERSION}${C_OFF} — plugins de Neovim sin git, ligeros.

  ${C_BOLD}plugvault${C_OFF} [sync]              Descarga/actualiza todo el manifest
  ${C_BOLD}plugvault add${C_OFF} user/repo ...   Añade plugins al manifest
  ${C_BOLD}plugvault list${C_OFF}                Lista plugins y su estado
  ${C_BOLD}plugvault prune${C_OFF}               Borra carpetas que ya no están en el manifest
  ${C_BOLD}plugvault help${C_OFF}

Opciones:
  -j N, --jobs N     Descargas simultáneas (por defecto: ${PLUGVAULT_JOBS})
  --keep-tests       No borrar tests/ test/ spec/
  --keep-media       No borrar imágenes ni vídeos

Entorno:
  PLUGVAULT_DIR       ${PLUGVAULT_DIR}
  PLUGVAULT_MANIFEST  ${PLUGVAULT_MANIFEST}
  PLUGVAULT_JOBS      ${PLUGVAULT_JOBS}

Manifest (una línea por plugin):
  nvim-lua/plenary.nvim
  nvim-treesitter/nvim-treesitter@v0.9.2     # tag o rama
  # esto es un comentario

Cargar los plugins en Neovim (init.lua):
  local vault = vim.fn.stdpath("config") .. "/plugvault"
  for _, p in ipairs(vim.fn.globpath(vault, "*", false, true)) do
    if vim.fn.isdirectory(p) == 1 then vim.opt.runtimepath:append(p) end
  end
EOF
}

# ── Dispatch ──────────────────────────────────────────────────────────────────
main() {
  local cmd=sync
  case "${1:-}" in
    sync|add|list|prune|help) cmd=$1; shift ;;
    -h|--help)                cmd=help; shift ;;
  esac

  local -a rest=()
  while (($#)); do
    case $1 in
      -j|--jobs)    PLUGVAULT_JOBS=${2:?falta N}; shift 2 ;;
      --keep-tests) KEEP_TESTS=1; shift ;;
      --keep-media) KEEP_MEDIA=1; shift ;;
      -h|--help)    cmd_help; return 0 ;;
      --)           shift; rest+=("$@"); break ;;
      *)            rest+=("$1"); shift ;;
    esac
  done

  [[ $PLUGVAULT_JOBS =~ ^[1-9][0-9]*$ ]] || die "--jobs debe ser un entero > 0"

  case $cmd in
    sync)  cmd_sync ;;
    add)   cmd_add "${rest[@]}" ;;
    list)  cmd_list ;;
    prune) cmd_prune ;;
    help)  cmd_help ;;
  esac
}

main "$@"
